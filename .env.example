# ==============================================================================
# PrintHive Simple - Environment Configuration
# ==============================================================================

# Server configuration
PORT=3001
NODE_ENV=development
DEV_MODE=true

# PocketBase Database Server
POCKETBASE_URL=https://pocketbase.amcloud.dev
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# SMTP Email Configuration (for sending 6-digit codes and print completion alerts)
# When DEV_MODE=true, verification codes are also printed to the server terminal
# and available in the UI toast for effortless testing without SMTP credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PrintHive Purdue <noreply@purdue.edu>
