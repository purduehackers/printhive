# Copy to .env. Generate a secret with:
# bun -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
CONFIRMATION_SECRET=
APP_ORIGIN=http://localhost:4321
DATA_DIR=./data
HOST=0.0.0.0
PORT=4321

# Production: Cloudflare SMTPS endpoint/credentials, port 465, SMTP_SECURE=true.
# These development defaults send to a local Mailpit container.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=PrintHive <prints@purdue.edu>

MAX_CONCURRENT_UPLOADS=2
UPLOAD_TTL_SECONDS=1800
# Enable only when the backend is private and the reverse proxy overwrites X-Real-IP.
TRUST_PROXY=false

# Optional operator desktop/Android Web Push. Generate once with bun run push:keys.
# Set all three to enable delivery; retain the same keys across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
