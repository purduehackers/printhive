---
import Layout from '../layouts/Layout.astro';
import SubmissionForm from '../components/SubmissionForm';
import { listMaterialsWithColors } from '../lib/server/materials';
const materials = await listMaterialsWithColors();
---
<Layout title="Submit a print" active="submit"><div class="page-heading"><h1>Submit a print</h1></div><SubmissionForm initialMaterials={materials} client:load /><noscript><p class="notice">Enable JavaScript to upload and preview your STL.</p></noscript></Layout>
