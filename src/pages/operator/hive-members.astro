---
import Layout from '../../layouts/Layout.astro';
import { currentOperator } from '../../lib/server/auth';
import { addHiveEmails, listHiveEmails, previewHiveEmails, removeHiveEmail } from '../../lib/server/hive-whitelist';
import { smallBody } from '../../lib/server/http';
import { HttpError } from '../../lib/server/errors';
import { logFailure } from '../../lib/server/log';

if (!await currentOperator(Astro)) return Astro.redirect('/operator/login');
let text = '', error = '';
let preview: Awaited<ReturnType<typeof previewHiveEmails>> | undefined;
if (Astro.request.method === 'POST') {
  try {
    const form = await smallBody(Astro.request, false);
    text = form.get('emails') ?? '';
    const action = form.get('action');
    if (action === 'remove') {
      await removeHiveEmail(form.get('email') ?? '');
      return Astro.redirect('/operator/hive-members?removed=1', 303);
    }
    if (action === 'add') {
      const count = await addHiveEmails(text);
      return Astro.redirect('/operator/hive-members?added=' + count, 303);
    }
    preview = await previewHiveEmails(text);
  } catch (cause) {
    logFailure('hive.whitelist_failed', cause);
    Astro.response.status = cause instanceof HttpError ? cause.status : 500;
    error = cause instanceof HttpError ? cause.message : 'PrintHive could not update the whitelist.';
  }
}
const emails = await listHiveEmails();
const added = Astro.url.searchParams.get('added');
---
<Layout title="Manage HIVE members" active="operator">
  <div class="page-heading operator-heading">
    <h1>Manage HIVE members</h1>
    <a class="button secondary" href="/operator">Back to print jobs</a>
  </div>
  {error && <p class="notice error" role="alert">{error}</p>}
  {added !== null && /^\d+$/.test(added) && <p class="notice" role="status">Added {added} HIVE member emails.</p>}
  {Astro.url.searchParams.has('removed') && <p class="notice" role="status">Removed HIVE sign-in access.</p>}
  <section class="detail-card">
    <form method="post">
      <label for="hive-emails">Add HIVE emails</label>
      <p id="hive-email-help" class="small muted">Enter one Purdue email or paste an email column, one address per line.</p>
      <textarea id="hive-emails" name="emails" rows="7" maxlength="16000" required aria-describedby="hive-email-help">{text}</textarea>
      <button type="submit" name="action" value="preview" class="button primary">Preview additions</button>
    </form>
    {preview && <div>
      <h2>Import preview</h2>
      <p>{preview.emails.length} to add · {preview.duplicates} duplicates · {preview.invalid.length} invalid</p>
      {preview.invalid.length > 0 && <p class="notice error">Skipped invalid rows: {preview.invalid.join(', ')}</p>}
      {preview.emails.length > 0 && <form method="post">
        <ul>{preview.emails.map(email => <li>{email}</li>)}</ul>
        <input type="hidden" name="emails" value={preview.emails.join('\n')} />
        <button type="submit" name="action" value="add" class="button primary">Add {preview.emails.length} emails</button>
      </form>}
    </div>}
  </section>
  <section class="detail-card">
    <h2>Whitelisted emails ({emails.length})</h2>
    {emails.length ? <ul>{emails.map(email => <li>
      <form method="post">
        <input type="hidden" name="email" value={email} />
        <span>{email}</span>{' '}
        <button type="submit" name="action" value="remove" class="button secondary" aria-label={`Remove ${email}`}>Remove</button>
      </form>
    </li>)}</ul> : <p>No HIVE emails yet.</p>}
  </section>
</Layout>
