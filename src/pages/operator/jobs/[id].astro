---
import Layout from '../../../layouts/Layout.astro';
import StatusControls from '../../../components/StatusControls';
import { currentOperator } from '../../../lib/server/auth';
import { db } from '../../../lib/server/db';
import { reference, supportLabel, type Job, type Status } from '../../../lib/shared';
if (!await currentOperator(Astro)) return Astro.redirect('/operator/login');
const sql = await db();
const [job]: Job[] = await sql`SELECT * FROM jobs WHERE id = ${Astro.params.id ?? ''} AND confirmed_at IS NOT NULL`;
if (!job) { Astro.response.status = 404; }
const events: { previous_status: string; next_status: string; username: string | null; created_at: number }[] = job ? await sql`SELECT e.*, o.username FROM job_events e LEFT JOIN operators o ON o.id = e.operator_id WHERE job_id = ${job.id} ORDER BY e.id DESC` : [];
---
<Layout title={job?.title ?? 'Print not found'} active="operator"><div class="page-heading"><a class="back-link" href="/operator">← Operator workspace</a><p class="eyebrow">{job ? `Print #${reference(job.id)}` : '404'}</p><h1>{job?.title ?? 'Print not found.'}</h1>{job && <p>{job.email}</p>}</div>{job && <div class="detail-grid"><div><section class="detail-card"><div class="section-heading"><h2>Print instructions</h2><a class="button secondary" href={`/api/jobs/${job.id}/file`}>Download STL ↓</a></div><p class="small muted">{job.original_filename} · {(job.file_size / 1024 ** 2).toFixed(2)} MiB</p><dl class="settings-grid"><div><dt>Filament</dt><dd><i class={`swatch ${job.color}`} />{job.color}</dd></div><div><dt>Infill</dt><dd>{job.infill}%</dd></div><div><dt>Layer height</dt><dd>{job.layer_height} mm</dd></div><div><dt>Supports</dt><dd>{supportLabel(job.supports)}</dd></div><div><dt>Copies</dt><dd>{job.copies}</dd></div><div><dt>Mirror X axis</dt><dd>{job.mirror ? 'Yes' : 'No'}</dd></div></dl><h3>Operator notes</h3><p class="operator-notes">{job.notes || 'No notes provided.'}</p></section><section class="detail-card"><h2>Status history</h2><ul class="history">{events.map(event => <li><strong>{event.previous_status} → {event.next_status}</strong><span>{event.username ?? 'Operator'} · {new Date(event.created_at).toLocaleString('en-US', {timeZone: 'America/Indiana/Indianapolis'})} ET</span></li>)}<li><strong>Email confirmed · joined the queue</strong><span>{new Date(job.confirmed_at).toLocaleString('en-US', {timeZone: 'America/Indiana/Indianapolis'})} ET</span></li></ul></section></div><StatusControls id={job.id} status={job.status as Status} version={job.version} client:load /></div>}</Layout>
