---
import Layout from '../../layouts/Layout.astro';
import { currentOperator } from '../../lib/server/auth';
import { db } from '../../lib/server/db';
import { STATUSES, reference, type Job } from '../../lib/shared';
const operator = await currentOperator(Astro);
if (!operator) return Astro.redirect('/operator/login');
const sql = await db();
const filter = STATUSES.find(s => s === Astro.url.searchParams.get('status')) ?? 'all';
const page = Math.min(100000, Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') ?? '1') || 1));
const jobs: Job[] = await sql`SELECT * FROM jobs WHERE confirmed_at IS NOT NULL AND (${filter} = 'all' OR status = ${filter})
  ORDER BY CASE status WHEN 'printing' THEN 0 WHEN 'queued' THEN 1 ELSE 2 END,
  CASE WHEN status IN ('queued','printing') THEN queued_at ELSE -created_at END, id LIMIT 51 OFFSET ${(page - 1) * 50}`;
---
<Layout title="Operator dashboard" active="operator"><div class="page-heading operator-heading"><div><p class="eyebrow">Operator workspace</p><h1>Keep the hive moving.</h1><p>Signed in as <strong>{operator.username}</strong></p></div><form method="post" action="/api/logout"><button class="button secondary">Sign out</button></form></div><nav class="filter-tabs" aria-label="Filter prints">{['all', ...STATUSES].map(status => <a class={status === filter ? 'selected' : ''} href={`/operator?status=${status}`} aria-current={status === filter ? 'page' : undefined}>{status}</a>)}</nav><div class="table-wrap"><table><thead><tr><th>Print</th><th>Submitter</th><th>Settings</th><th>Status</th><th><span class="sr-only">Action</span></th></tr></thead><tbody>{jobs.slice(0, 50).map(job => <tr><td><a class="job-title" href={`/operator/jobs/${job.id}`}>{job.title}</a><span class="mono small muted">#{reference(job.id)}</span></td><td>{job.email}</td><td>{job.color} · {job.copies}×<br /><span class="muted small">{job.layer_height} mm · {job.infill}%</span></td><td><span class={`status ${job.status}`}>{job.status}</span></td><td><a href={`/operator/jobs/${job.id}`} aria-label={`Manage ${job.title}`}>Manage →</a></td></tr>)}</tbody></table>{!jobs.length && <div class="empty-state">No confirmed prints in this view.</div>}</div><div class="pagination">{page > 1 && <a href={`/operator?status=${filter}&page=${page - 1}`}>← Previous</a>}<span>Page {page}</span>{jobs.length > 50 && <a href={`/operator?status=${filter}&page=${page + 1}`}>Next →</a>}</div></Layout>
