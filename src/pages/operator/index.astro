---
import Layout from '../../layouts/Layout.astro';
import OperatorQueue from '../../components/OperatorQueue';
import OperatorNotifications from '../../components/OperatorNotifications';
import { currentOperator } from '../../lib/server/auth';
import { operatorQueue } from '../../lib/server/jobs';
import { STATUSES, effectiveGroupName, reference } from '../../lib/shared';
import '../../styles/print-thumbnails.css';

const operator = await currentOperator(Astro);
if (!operator) return Astro.redirect('/operator/login');
const { jobs, filter, page, hasNext, revision } = await operatorQueue(Astro.url.searchParams.get('status'), Astro.url.searchParams.get('page'));
---
<Layout title="Operator dashboard" active="operator">
  <div class="page-heading operator-heading">
    <div>
      <h1>Print jobs</h1>
      <p>Signed in as <strong>{operator.username}</strong></p>
    </div>
    <div class="operator-actions">
      <a class="button secondary" href="/operator/manage-materials">Manage materials</a>
      <a class="button secondary" href="/operator/manage-operators">Manage operators</a>
      <form method="post" action="/api/logout">
        <button class="button secondary">Sign out</button>
      </form>
    </div>
  </div>

  <nav class="filter-tabs" aria-label="Filter prints">
    {['all', ...STATUSES].map(status => (
      <a
        class={status === filter ? 'selected' : ''}
        href={`/operator?status=${status}`}
        aria-current={status === filter ? 'page' : undefined}
      >
        {status}
      </a>
    ))}
  </nav>

  <OperatorQueue initialJobs={jobs} filter={filter} page={page} revision={revision} client:load />

  <noscript>
    <div class="table-wrap">
      <table class="operator-queue-table">
        <thead>
          <tr>
            <th>Print</th>
            <th>Submitter</th>
            <th>Settings</th>
            <th>Status</th>
            <th><span class="sr-only">Action</span></th>
          </tr>
        </thead>
        <tbody>
          {jobs.slice(0, 50).map(job => (
            <tr>
              <td>
                <div class="operator-print-summary">
                  <span class="operator-print-artwork" aria-hidden="true">
                    {Boolean(job.has_thumbnail) && <img class="operator-print-thumbnail" src={`/api/print-thumbnails/${job.id}`} width="36" height="36" alt="" loading="lazy" decoding="async" />}
                  </span>
                  <div class="operator-print-details">
                    <a class="job-title" href={`/operator/jobs/${job.id}`}>{job.title}</a>
                    <span class="mono small muted">#{reference(job.id)}</span>
                    {effectiveGroupName(job) && <span class="group-badge">{effectiveGroupName(job)}</span>}
                  </div>
                </div>
              </td>
              <td>{job.email}</td>
              <td>
                {job.material ?? 'PLA'} · {job.color} · {job.copies}×<br />
                <span class="muted small">{job.layer_height} mm · {job.infill}% · {job.walls} walls</span>
              </td>
              <td><span class={`status ${job.status}`}>{job.status}</span></td>
              <td><a href={`/operator/jobs/${job.id}`} aria-label={`Manage ${job.title}`}>Manage →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
      {!jobs.length && <div class="empty-state">No confirmed prints in this view.</div>}
    </div>
  </noscript>

  <div class="pagination">
    {page > 1 && <a href={`/operator?status=${filter}&page=${page - 1}`}>← Previous</a>}
    <span>Page {page}</span>
    {hasNext && <a href={`/operator?status=${filter}&page=${page + 1}`}>Next →</a>}
  </div>

  <OperatorNotifications client:load />
</Layout>
