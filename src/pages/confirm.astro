---
import Layout from '../layouts/Layout.astro';
import { confirmation } from '../lib/server/jobs';
import { smallBody } from '../lib/server/http';
import { HttpError } from '../lib/server/errors';
import { logFailure } from '../lib/server/log';
import { config } from '../lib/server/config';
import { VERIFIED_EMAIL_COOKIE, VERIFIED_EMAIL_TTL, sealVerifiedEmail } from '../lib/server/tokens';
import { effectiveGroupName, reference, summarizeGroupStatus, type Job, type Status } from '../lib/shared';
let token = Astro.url.searchParams.get('token') ?? '', job: Job | undefined, jobs: Job[] = [], already = false, error = '';
let verifiedToken = '', verifiedExpires = 0;
const submitted = Astro.request.method === 'POST';
try {
  if (submitted) token = (await smallBody(Astro.request, false)).get('token') ?? '';
  ({ job, jobs, already } = await confirmation(token, submitted));
  if (submitted && job?.email) {
    verifiedExpires = Date.now() + VERIFIED_EMAIL_TTL;
    verifiedToken = sealVerifiedEmail(job.email, verifiedExpires);
    Astro.cookies.set(VERIFIED_EMAIL_COOKIE, verifiedToken, {
      httpOnly: true,
      secure: config().production,
      sameSite: 'lax',
      path: '/',
      expires: new Date(verifiedExpires),
    });
  }
} catch (e) {
  logFailure('confirmation.failed', e, { method: Astro.request.method });
  error = e instanceof HttpError ? e.message : 'We could not confirm this print. Please try again later.';
  Astro.response.status = e instanceof HttpError ? e.status : 500;
}
const isBatch = jobs.length > 1;
const batchGroup = job ? effectiveGroupName(job) : null;
const batchSummary = isBatch && (submitted || already)
  ? summarizeGroupStatus(jobs.filter(j => j.status !== 'pending_confirmation') as { status: Status }[])
  : null;
---
<Layout title={isBatch ? 'Confirm your prints' : 'Confirm your print'}>
  <section class="receipt">
    <h1>{error ? 'Confirmation failed' : already ? 'Already confirmed' : submitted ? (isBatch ? 'Prints queued' : 'Print queued') : (isBatch ? 'Confirm your prints' : 'Confirm your print')}</h1>
    {error ? (
      <p class="notice error">{error}</p>
    ) : isBatch ? (
      <>
        {batchGroup && <h2>{batchGroup}</h2>}
        <p class="muted">
          {jobs.length} prints in this batch
          {batchSummary && <> · <span class={`status ${batchSummary.status}`}>{batchSummary.label}</span></>}
        </p>
        <ul class="batch-confirm-list">
          {jobs.map(j => (
            <li>
              <strong>{j.title}</strong>
              <span class="batch-confirm-meta">
                {(submitted || already) && j.status !== 'pending_confirmation' && (
                  <span class={`status ${j.status}`}>{j.status}</span>
                )}
                <span class="mono">#{reference(j.id)}</span>
              </span>
            </li>
          ))}
        </ul>
        <p>{already ? `These prints have already been confirmed${batchSummary ? ` (${batchSummary.label})` : ''}.` : submitted ? 'Your prints are grouped and queued. We’ll email you when an operator changes their status.' : 'Press the button below to confirm your batch and join the queue.'}</p>
        {!submitted && !already && (
          <form method="post" action="/confirm">
            <input type="hidden" name="token" value={token} />
            <button class="button primary" type="submit">Confirm {jobs.length} prints</button>
          </form>
        )}
      </>
    ) : (
      <>
        <h2>{job?.title}</h2>
        <p class="mono">#{job && reference(job.id)}</p>
        <p>{already ? `This print has already been confirmed. Its current status is ${job?.status}.` : submitted ? 'Your print is queued. We’ll email you when the operator changes its status.' : 'Press the button below to confirm your print and join the queue.'}</p>
        {!submitted && !already && (
          <form method="post" action="/confirm">
            <input type="hidden" name="token" value={token} />
            <button class="button primary" type="submit">Confirm print</button>
          </form>
        )}
      </>
    )}
    <a href={error ? '/submit' : '/'} class={submitted || already || error ? 'button primary' : 'text-button'}>{error ? 'Submit a new print' : 'View queue'}</a>
  </section>
  {verifiedToken && job?.email && (
    <script is:inline define:vars={{ email: job.email.toLowerCase(), verifiedToken, verifiedExpires }}>
      try {
        localStorage.setItem('printhive_verified_email', JSON.stringify({ email, token: verifiedToken, expires: verifiedExpires }));
      } catch {}
    </script>
  )}
</Layout>
