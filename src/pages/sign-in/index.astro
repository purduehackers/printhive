---
import Layout from '../../layouts/Layout.astro';
import { currentMember, hiveSignInDestination, sendMemberLink } from '../../lib/server/member-auth';
import { afterSignIn, startIdSignIn } from '../../lib/server/purdue-id';
import { clientIP, rateLimit, smallBody } from '../../lib/server/http';
import { HttpError } from '../../lib/server/errors';
import { logFailure } from '../../lib/server/log';

const requested = Astro.url.searchParams.get('next');
Astro.response.headers.set('Cache-Control', 'private, no-store');
const next = afterSignIn(requested);
const hiveNext = hiveSignInDestination(requested);
const member = await currentMember(Astro);
if (member) return Astro.redirect(next === '/operator' && !member.organizer ? '/' : next);
const retry = '/sign-in?' + new URLSearchParams({ next: requested === null ? '/manage-prints' : next });
let email = '', sent = false, error = '';
const idError = Astro.url.searchParams.has('id_error');
let failedAction = '';
if (Astro.request.method === 'POST') {
  try {
    rateLimit('sign-in:' + clientIP(Astro), 15, 900000);
    const form = await smallBody(Astro.request, false);
    failedAction = form.get('action') ?? 'hive';
    if (failedAction === 'id') return await startIdSignIn(Astro, next);
    email = (form.get('email') ?? '').trim();
    await sendMemberLink(Astro, email, null, undefined, hiveNext);
    sent = true;
  } catch (cause) {
    logFailure('member.sign_in_failed', cause);
    Astro.response.status = cause instanceof HttpError ? cause.status : 502;
    error = cause instanceof HttpError ? cause.message : 'Sign-in is temporarily unavailable. Try again shortly.';
  }
}
---
<Layout title={sent ? 'Check your email' : 'Sign in'} active="sign-in">
  <section class:list={['login-panel', 'member-login', { 'member-login-choice': !sent }]}>
    {sent ? <>
      <h1>Check your email</h1>
      <p role="status">If <strong>{email}</strong> is registered with HIVE, you’ll receive a sign-in link. It expires in 15 minutes.</p>
      <p>Check your spam folder if the link doesn’t arrive.</p>
      <form method="post" class="member-actions">
        <input type="hidden" name="email" value={email} />
        <button type="submit" class="button secondary" name="action" value="resend">Resend link</button>
        <a href={retry}>Change email</a>
      </form>
    </> : <>
      <h1>Sign in to PrintHive</h1>
      {error && !failedAction && <p class="notice error" role="alert">{error}</p>}
      <div class="sign-in-options">
        <section aria-labelledby="hive-sign-in">
          <h2 id="hive-sign-in">HIVE member</h2>
          <p>Use the @purdue.edu email you registered with HIVE.</p>
          {error && failedAction && failedAction !== 'id' && <p class="notice error" role="alert">{error}</p>}
          <form method="post">
            <label>Purdue email <input name="email" type="email" autocomplete="email" maxlength="254" value={email} required /></label>
            <button type="submit" name="action" value="hive" class="button secondary">Email me a sign-in link</button>
          </form>
        </section>
        <section aria-labelledby="id-sign-in">
          <h2 id="id-sign-in">Purdue Hackers ID</h2>
          <p>Use your Purdue Hackers ID account to sign in.</p>
          {idError && <p class="notice error" role="alert">Purdue Hackers ID sign-in didn’t finish. Try again below.</p>}
          {error && failedAction === 'id' && <p class="notice error" role="alert">{error}</p>}
          <form method="post">
            <button type="submit" name="action" value="id" class="button secondary">Continue with Purdue Hackers ID</button>
          </form>
        </section>
      </div>
    </>}
  </section>
</Layout>
