---
import Layout from '../layouts/Layout.astro';
import Queue from '../components/Queue';
import { publicQueue } from '../lib/server/jobs';
const jobs = await publicQueue();
---
<Layout active="queue">
  <section class="hero"><div><p class="eyebrow">Purdue’s ideas, taking shape</p><h1>Big ideas.<br /><span>Layer by layer.</span></h1><p class="hero-description">A home for your next prototype, spare part, or “what if.”<br class="desktop-break" /> Send it to the hive. We’ll take it from here.</p><a class="button primary" href="/submit">Submit a print <span aria-hidden="true">↗</span></a></div><div class="hero-art" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="stacked-object">{Array.from({length: 14}, (_, i) => <div style={`--i:${i}`}></div>)}</div><span class="art-label mono">IDEA → STL → SOMETHING REAL</span></div></section>
  <Queue initial={jobs} client:load />
  <aside class="how-it-works"><p class="eyebrow">From file to finished</p><div><span>01</span><h3>Make it yours.</h3><p>Upload an STL and choose your print settings.</p></div><div><span>02</span><h3>Check your inbox.</h3><p>Confirm with your Purdue email within 24 hours.</p></div><div><span>03</span><h3>Watch it take shape.</h3><p>Follow the queue. We’ll email you as things move.</p></div></aside>
</Layout>
