{
  "name": "printhive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/preflight.ts && bun run db:migrate && bun --bun astro dev --host 0.0.0.0",
    "check": "bun --bun astro check",
    "build": "bun run preview:runtime && bun --bun astro build",
    "start": "bun scripts/preflight.ts && bun run db:migrate && bun dist/server/entry.mjs",
    "test": "bun test tests",
    "test:e2e": "bun scripts/e2e.ts",
    "test:browser": "bun scripts/browser-test.ts && bun scripts/settings-browser-test.ts && bun scripts/profile-browser-test.ts && bun scripts/support-angle-browser-test.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "operator:add": "bun scripts/operator.ts",
    "cleanup": "bun scripts/cleanup.ts",
    "preview:runtime": "bun node_modules/@time-estimator/browser-preview/scripts/fetch-runtime.mjs public/preview-engine --replace"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.0",
    "astro": "^7.4.1",
    "nodemailer": "^10.1.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "^0.186.1",
    "@time-estimator/browser-preview": "file:vendor/time-estimator-browser-preview-0.5.0.0c616838ed2f.tgz"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "5.9.3"
  }
}
