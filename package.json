{
  "name": "printhive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/preflight.ts && bun run db:migrate && bun --bun astro dev --host 0.0.0.0",
    "check": "bun --bun astro check",
    "build": "bun --bun astro build",
    "start": "bun scripts/preflight.ts && bun run db:migrate && bun dist/server/entry.mjs",
    "test": "bun test tests",
    "test:e2e": "bun scripts/e2e.ts",
    "test:browser": "bun scripts/browser-test.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "operator:add": "bun scripts/operator.ts",
    "cleanup": "bun scripts/cleanup.ts"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.8",
    "@astrojs/react": "^7.1.0",
    "astro": "^7.4.0",
    "nodemailer": "^10.1.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "5.9.3"
  }
}
